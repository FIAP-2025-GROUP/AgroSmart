# Modelo de configuração do AgroSmart.
#
# ESTE ARQUIVO NÃO LEVA CHAVE REAL. Ele é versionado e vai junto no .zip da
# entrega — qualquer valor colocado aqui fica visível para quem receber.
#
# A chave de verdade vai no `.env`, que está no .gitignore:
#
#     copy .env.example .env
#
# Depois abra o `.env` e substitua o placeholder abaixo pela sua chave.

# Chave gratuita do Google Gemini: https://aistudio.google.com/apikey
# Não precisa de cartão de crédito.
GEMINI_API_KEY=cole-sua-chave-aqui
