.venv/
__pycache__/
*.pyc

# Lixo de editor e de sistema. O `~$...` é o arquivo de trava que o Word cria
# enquanto o .docx está aberto — some sozinho ao fechar, mas se for commitado
# fica no repositório para sempre.
~$*
*.tmp
Thumbs.db
.DS_Store

# Segredos. NUNCA versione o .env nem o inclua no .zip da entrega —
# o modelo sem valores reais é o .env.example, esse sim vai versionado.
.env
.env.local

# Resultados gerados em execução — o .zip da entrega leva apenas um exemplo,
# adicionado manualmente.
exportacoes/*.csv
exportacoes/*.json

# Histórico local de laudos. Pode conter fotos suas; gere um novo em vez de
# versionar este.
dados/historico.db

# O modelo treinado (~14 MB) É versionado de propósito: sem ele o avaliador
# não consegue rodar o app. Não adicione modelo/ aqui.

# Fase 2 — camadas geradas pelo pipeline. São reconstruídas a partir do RAW;
# não precisam ir para o repositório.
dados/raw/
dados/bronze/
dados/silver/
dados/gold/
dados/exportacoes/
# `dados/simulados/` e `dados/processados/` NÃO estão aqui de propósito: o
# primeiro é reprodutível e pequeno, o segundo permite abrir o dashboard sem
# Java/Spark. Se o histórico real tiver dados que você não quer publicar, gere
# o pacote só com `--origem simulado` antes de versionar.
